APP_NAME="AI Interview Analysis Platform"
ENVIRONMENT=development

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_growth_platform

JWT_SECRET_KEY=change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_PASSWORD_RESET_EXPIRE_MINUTES=15

# Optional but recommended for protected admin-only setup endpoints.
ADMIN_SYNC_TOKEN=change-this-admin-token

# The Master tracker sheet. Used as the default source for /students/import-sheet
# and REQUIRED by the scheduled sync (run_incremental_sync.py), which has no
# admin to pick a link for it. Must be shared as "Anyone with the link - Viewer".
STUDENT_SHEET_URL=""
